{
  "name": "@zensation/adapter-sqlite",
  "version": "0.2.2",
  "description": "SQLite storage adapter for ZenBrain agent memory: an LLM agent's whole long-term memory in one portable file, no server and no network hop. Same StorageAdapter interface as the Postgres adapter, so moving between them is a one-line change.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zenbrain",
    "sqlite",
    "better-sqlite3",
    "ai-memory",
    "agent-memory",
    "long-term-memory",
    "storage-adapter",
    "zero-config",
    "embedded-database",
    "llm-memory",
    "ai-agents",
    "longmemeval",
    "llm-agents"
  ],
  "author": "Zensation AI <open-source@zensation.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zensation-ai/zenbrain.git",
    "directory": "packages/adapters/sqlite"
  },
  "homepage": "https://github.com/zensation-ai/zenbrain/tree/main/packages/adapters/sqlite#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "peerDependencies": {
    "@zensation/core": "^0.2.0 || ^0.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "vitest": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
