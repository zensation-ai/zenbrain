{
  "name": "@zensation/core",
  "version": "0.3.4",
  "description": "7-layer memory system for AI agents. Pluggable storage, embeddings, and LLM providers. Built on @zensation/algorithms.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./interfaces": {
      "import": {
        "types": "./dist/interfaces/index.d.ts",
        "default": "./dist/interfaces/index.js"
      },
      "require": {
        "types": "./dist/interfaces/index.d.cts",
        "default": "./dist/interfaces/index.cjs"
      }
    },
    "./layers/working": {
      "import": {
        "types": "./dist/layers/working.d.ts",
        "default": "./dist/layers/working.js"
      },
      "require": {
        "types": "./dist/layers/working.d.cts",
        "default": "./dist/layers/working.cjs"
      }
    },
    "./layers/short-term": {
      "import": {
        "types": "./dist/layers/short-term.d.ts",
        "default": "./dist/layers/short-term.js"
      },
      "require": {
        "types": "./dist/layers/short-term.d.cts",
        "default": "./dist/layers/short-term.cjs"
      }
    },
    "./layers/episodic": {
      "import": {
        "types": "./dist/layers/episodic.d.ts",
        "default": "./dist/layers/episodic.js"
      },
      "require": {
        "types": "./dist/layers/episodic.d.cts",
        "default": "./dist/layers/episodic.cjs"
      }
    },
    "./layers/semantic": {
      "import": {
        "types": "./dist/layers/semantic.d.ts",
        "default": "./dist/layers/semantic.js"
      },
      "require": {
        "types": "./dist/layers/semantic.d.cts",
        "default": "./dist/layers/semantic.cjs"
      }
    },
    "./layers/procedural": {
      "import": {
        "types": "./dist/layers/procedural.d.ts",
        "default": "./dist/layers/procedural.js"
      },
      "require": {
        "types": "./dist/layers/procedural.d.cts",
        "default": "./dist/layers/procedural.cjs"
      }
    },
    "./layers/core": {
      "import": {
        "types": "./dist/layers/core.d.ts",
        "default": "./dist/layers/core.js"
      },
      "require": {
        "types": "./dist/layers/core.d.cts",
        "default": "./dist/layers/core.cjs"
      }
    },
    "./layers/cross-context": {
      "import": {
        "types": "./dist/layers/cross-context.d.ts",
        "default": "./dist/layers/cross-context.js"
      },
      "require": {
        "types": "./dist/layers/cross-context.d.cts",
        "default": "./dist/layers/cross-context.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai-memory",
    "agent-memory",
    "memory-layers",
    "working-memory",
    "episodic-memory",
    "semantic-memory",
    "procedural-memory",
    "long-term-memory",
    "ai-agents",
    "llm-memory",
    "neuroscience",
    "cognitive-architecture",
    "pluggable-adapters",
    "zenbrain"
  ],
  "author": "Zensation AI <open-source@zensation.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zensation-ai/zenbrain.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/zensation-ai/zenbrain/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/zensation-ai/zenbrain/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@zensation/algorithms": "^0.4.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
